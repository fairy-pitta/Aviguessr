{
  "name": "aviguessr",
  "main": "worker/index.ts",
  "compatibility_date": "2025-03-31",
  "assets": {
    "directory": "dist",
    // Client-side routes: /daily and /game/:id are React Router paths, not
    // files. Without this, opening, refreshing or sharing one is a 404.
    "not_found_handling": "single-page-application",
    // ...but the SPA fallback would swallow the API too, so those paths reach
    // the Worker first.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aviguessr-db",
      "database_id": "41cf992b-e7e8-4282-921f-16278f667b37"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "aviguessr-images"
    }
  ]
}
